{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil datar setiap pendaftar Google untuk pemantauan rilis dan identitas kop depot",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID pengguna" },
        "email": { "type": "string", "description": "Alamat email Google pengguna" },
        "googleDisplayName": { "type": "string", "description": "Nama asli akun Google pengguna" },
        "ownerName": { "type": "string", "description": "Nama Pemilik Depot" },
        "depotName": { "type": "string", "description": "Nama Depot untuk kop struk dan PDF" },
        "phoneNumber": { "type": "string", "description": "Nomor HP / WhatsApp Depot" },
        "address": { "type": "string", "description": "Alamat lengkap atau kota Depot" },
        "receiptFooter": { "type": "string", "description": "Catatan kaki struk opsional" },
        "role": { "type": "string", "enum": ["OWNER", "STAFF"], "description": "Peran pengguna di depot" },
        "subscriptionTier": { "type": "string", "enum": ["FREE", "PRO"], "description": "Paket langganan akun" },
        "registeredAt": { "type": "string", "format": "date-time", "description": "Server timestamp pendaftaran pertama" },
        "lastActiveAt": { "type": "string", "format": "date-time", "description": "Server timestamp aktivitas terakhir" },
        "appVersion": { "type": "string", "description": "Versi aplikasi (BuildConfig.VERSION_NAME)" },
        "depotType": { "type": "string", "enum": ["RO", "MINERAL", "BOTH"], "description": "Jenis usaha depot" },
        "tankCapacityLiters": { "type": "number", "description": "Kapasitas toren air mineral (liter)" },
        "currentTankStockLiters": { "type": "number", "description": "Sisa stok air toren saat ini (liter)" }
      },
      "required": ["uid", "email", "googleDisplayName", "ownerName", "depotName", "phoneNumber", "address", "receiptFooter", "role", "subscriptionTier", "registeredAt", "lastActiveAt", "appVersion"]
    },
    "Depot": {
      "title": "Depot",
      "description": "Workspace depot bersama antara Pemilik dan Karyawan aktif",
      "type": "object",
      "properties": {
        "depotId": { "type": "string", "description": "ID unik depot" },
        "ownerUid": { "type": "string", "description": "UID Pemilik Depot" },
        "ownerEmail": { "type": "string", "description": "Email Google Pemilik Depot" },
        "name": { "type": "string", "description": "Nama tampilan depot" },
        "depotName": { "type": "string", "description": "Nama resmi depot untuk kop struk/nota/PDF" },
        "ownerName": { "type": "string", "description": "Nama pemilik depot" },
        "phoneNumber": { "type": "string", "description": "Nomor HP / WhatsApp depot" },
        "address": { "type": "string", "description": "Alamat atau kota depot" },
        "receiptFooter": { "type": "string", "description": "Catatan kaki struk opsional" },
        "subscriptionTier": { "type": "string", "enum": ["FREE", "PRO"], "description": "Status paket pemilik depot" },
        "memberEmails": { "type": "array", "description": "Daftar email karyawan aktif (maksimal 30)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembuatan" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan terakhir" },
        "depotType": { "type": "string", "enum": ["RO", "MINERAL", "BOTH"], "description": "Jenis usaha depot" },
        "tankCapacityLiters": { "type": "number", "description": "Kapasitas toren air mineral (liter)" },
        "currentTankStockLiters": { "type": "number", "description": "Sisa stok air toren saat ini (liter)" }
      },
      "required": ["depotId", "ownerUid", "ownerEmail", "name", "memberEmails", "createdAt", "updatedAt"]
    },
    "StaffLink": {
      "title": "StaffLink",
      "description": "Tautan keanggotaan karyawan berdasarkan email Google terverifikasi",
      "type": "object",
      "properties": {
        "depotId": { "type": "string", "description": "ID depot tujuan" },
        "ownerUid": { "type": "string", "description": "UID Pemilik Depot" },
        "ownerEmail": { "type": "string", "description": "Email Pemilik Depot" },
        "staffEmail": { "type": "string", "description": "Email Google Karyawan (lowercase)" },
        "active": { "type": "boolean", "description": "Status akses karyawan" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembuatan" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan terakhir" }
      },
      "required": ["depotId", "ownerUid", "ownerEmail", "staffEmail", "active", "createdAt", "updatedAt"]
    },
    "Produk": {
      "title": "Produk",
      "description": "Data produk galon air minum",
      "type": "object",
      "properties": {
        "syncId": { "type": "string", "description": "UUID unik sinkronisasi" },
        "nama_produk": { "type": "string", "description": "Nama produk galon" },
        "harga": { "type": "number", "description": "Harga jual standar" },
        "updatedAt": { "type": "number", "description": "Epoch millis pembaruan terakhir" },
        "isDeleted": { "type": "boolean", "description": "Penanda hapus sinkronisasi" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan" }
      },
      "required": ["syncId", "nama_produk", "harga", "updatedAt", "isDeleted", "serverUpdatedAt"]
    },
    "Kurir": {
      "title": "Kurir",
      "description": "Data karyawan pengantar galon",
      "type": "object",
      "properties": {
        "syncId": { "type": "string", "description": "UUID unik sinkronisasi" },
        "nama": { "type": "string", "description": "Nama karyawan" },
        "komisi_per_galon": { "type": "number", "description": "Komisi tetap per galon" },
        "email": { "type": "string", "description": "Email Google karyawan" },
        "akses_aktif": { "type": "boolean", "description": "Status aktif akses karyawan" },
        "skema_komisi": { "type": "string", "description": "Skema komisi" },
        "aturan_komisi": { "type": "string", "description": "Aturan komisi" },
        "updatedAt": { "type": "number", "description": "Epoch millis pembaruan terakhir" },
        "isDeleted": { "type": "boolean", "description": "Penanda hapus sinkronisasi" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan" }
      },
      "required": ["syncId", "nama", "komisi_per_galon", "email", "akses_aktif", "skema_komisi", "aturan_komisi", "updatedAt", "isDeleted", "serverUpdatedAt"]
    },
    "Pelanggan": {
      "title": "Pelanggan",
      "description": "Data pelanggan depot air minum Santoya RO",
      "type": "object",
      "properties": {
        "syncId": { "type": "string", "description": "UUID unik sinkronisasi" },
        "nama": { "type": "string", "description": "Nama pelanggan" },
        "alamat": { "type": "string", "description": "Alamat pelanggan" },
        "no_hp": { "type": "string", "description": "Nomor WhatsApp/HP pelanggan" },
        "sisa_kasbon": { "type": "number", "description": "Sisa kasbon/piutang pelanggan" },
        "harga_khusus": { "type": "number", "description": "Harga khusus per galon jika ada" },
        "kurirSyncId": { "type": "string", "description": "SyncId kurir langganan jika ada" },
        "updatedAt": { "type": "number", "description": "Epoch millis pembaruan terakhir" },
        "isDeleted": { "type": "boolean", "description": "Penanda hapus sinkronisasi" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan" }
      },
      "required": ["syncId", "nama", "alamat", "no_hp", "sisa_kasbon", "updatedAt", "isDeleted", "serverUpdatedAt"]
    },
    "Transaksi": {
      "title": "Transaksi",
      "description": "Data transaksi penjualan galon air",
      "type": "object",
      "properties": {
        "syncId": { "type": "string", "description": "UUID unik sinkronisasi" },
        "tanggal": { "type": "number", "description": "Waktu transaksi dalam epoch millis" },
        "pelangganSyncId": { "type": "string", "description": "SyncId pelanggan terkait" },
        "kurirSyncId": { "type": "string", "description": "SyncId karyawan pengantar jika ada" },
        "produkSyncId": { "type": "string", "description": "SyncId produk terkait jika ada" },
        "jumlah": { "type": "number", "description": "Jumlah galon" },
        "harga_satuan": { "type": "number", "description": "Harga satuan galon" },
        "total_harga": { "type": "number", "description": "Total tagihan penjualan" },
        "total_komisi": { "type": "number", "description": "Total komisi pengantaran" },
        "metode_bayar": { "type": "string", "description": "Metode bayar" },
        "status": { "type": "string", "description": "Status pembayaran (Lunas/Kasbon)" },
        "uangMuka": { "type": "number", "description": "Nominal DP" },
        "sisaKasbon": { "type": "number", "description": "Sisa kasbon belum dibayar" },
        "tanggalBayar": { "type": "number", "description": "Epoch millis tanggal pelunasan nota" },
        "waterType": { "type": "string", "enum": ["RO", "MINERAL"], "description": "Jenis air galon" },
        "updatedAt": { "type": "number", "description": "Epoch millis pembaruan terakhir" },
        "isDeleted": { "type": "boolean", "description": "Penanda hapus sinkronisasi" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan" }
      },
      "required": ["syncId", "tanggal", "pelangganSyncId", "jumlah", "harga_satuan", "total_harga", "total_komisi", "metode_bayar", "status", "uangMuka", "sisaKasbon", "updatedAt", "isDeleted", "serverUpdatedAt"]
    },
    "Pengeluaran": {
      "title": "Pengeluaran",
      "description": "Data pengeluaran operasional depot (khusus Pemilik)",
      "type": "object",
      "properties": {
        "syncId": { "type": "string", "description": "UUID unik sinkronisasi" },
        "tanggal": { "type": "number", "description": "Waktu pengeluaran dalam epoch millis" },
        "nama_item": { "type": "string", "description": "Deskripsi pengeluaran" },
        "kategori": { "type": "string", "description": "Kategori pengeluaran" },
        "nominal": { "type": "number", "description": "Nominal rupiah" },
        "updatedAt": { "type": "number", "description": "Epoch millis pembaruan terakhir" },
        "isDeleted": { "type": "boolean", "description": "Penanda hapus sinkronisasi" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan" }
      },
      "required": ["syncId", "tanggal", "nama_item", "kategori", "nominal", "updatedAt", "isDeleted", "serverUpdatedAt"]
    },
    "KasbonLog": {
      "title": "KasbonLog",
      "description": "Riwayat pembayaran kasbon pelanggan",
      "type": "object",
      "properties": {
        "syncId": { "type": "string", "description": "UUID unik sinkronisasi" },
        "pelangganSyncId": { "type": "string", "description": "SyncId pelanggan" },
        "tanggal": { "type": "number", "description": "Waktu pembayaran kasbon" },
        "jumlah_bayar": { "type": "number", "description": "Nominal pembayaran kasbon" },
        "sisa_kasbon_sebelum": { "type": "number", "description": "Sisa kasbon sebelum bayar" },
        "sisa_kasbon_sesudah": { "type": "number", "description": "Sisa kasbon sesudah bayar" },
        "metode_bayar": { "type": "string", "description": "Metode pembayaran" },
        "catatan": { "type": "string", "description": "Keterangan pembayaran" },
        "updatedAt": { "type": "number", "description": "Epoch millis pembaruan terakhir" },
        "isDeleted": { "type": "boolean", "description": "Penanda hapus sinkronisasi" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan" }
      },
      "required": ["syncId", "pelangganSyncId", "tanggal", "jumlah_bayar", "sisa_kasbon_sebelum", "sisa_kasbon_sesudah", "metode_bayar", "catatan", "updatedAt", "isDeleted", "serverUpdatedAt"]
    },
    "PerawatanJadwal": {
      "title": "PerawatanJadwal",
      "description": "Jadwal perawatan berkala mesin RO depot (khusus Pemilik)",
      "type": "object",
      "properties": {
        "syncId": { "type": "string", "description": "UUID unik sinkronisasi" },
        "nama": { "type": "string", "description": "Nama komponen atau pekerjaan perawatan RO" },
        "intervalHari": { "type": "number", "description": "Interval perawatan dalam hari" },
        "terakhirSelesai": { "type": "number", "description": "Epoch millis penyelesaian terakhir (opsional)" },
        "jadwalBerikutnya": { "type": "number", "description": "Epoch millis jadwal perawatan berikutnya" },
        "updatedAt": { "type": "number", "description": "Epoch millis pembaruan terakhir" },
        "isDeleted": { "type": "boolean", "description": "Penanda hapus sinkronisasi" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan" }
      },
      "required": ["syncId", "nama", "intervalHari", "jadwalBerikutnya", "updatedAt", "isDeleted", "serverUpdatedAt"]
    },
    "PerawatanLog": {
      "title": "PerawatanLog",
      "description": "Riwayat pelaksanaan perawatan mesin RO depot (khusus Pemilik)",
      "type": "object",
      "properties": {
        "syncId": { "type": "string", "description": "UUID unik sinkronisasi" },
        "perawatanSyncId": { "type": "string", "description": "SyncId jadwal perawatan terkait" },
        "namaPerawatan": { "type": "string", "description": "Nama perawatan saat dikerjakan" },
        "tanggalSelesai": { "type": "number", "description": "Epoch millis tanggal selesai perawatan" },
        "biaya": { "type": "number", "description": "Biaya perawatan dalam rupiah" },
        "catatan": { "type": "string", "description": "Catatan pekerjaan perawatan" },
        "pengeluaranSyncId": { "type": "string", "description": "SyncId entri pengeluaran otomatis jika biaya > 0" },
        "updatedAt": { "type": "number", "description": "Epoch millis pembaruan terakhir" },
        "isDeleted": { "type": "boolean", "description": "Penanda hapus sinkronisasi" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan" }
      },
      "required": ["syncId", "perawatanSyncId", "namaPerawatan", "tanggalSelesai", "biaya", "catatan", "updatedAt", "isDeleted", "serverUpdatedAt"]
    },
    "TangkiRefill": {
      "title": "TangkiRefill",
      "description": "Riwayat pasokan air tangki toren mineral (khusus Pemilik)",
      "type": "object",
      "properties": {
        "syncId": { "type": "string", "description": "UUID unik sinkronisasi" },
        "tanggal": { "type": "number", "description": "Epoch millis waktu pasokan air masuk" },
        "volumeLiter": { "type": "number", "description": "Volume air masuk dalam liter" },
        "totalHarga": { "type": "number", "description": "Biaya beli pasokan air tangki" },
        "namaPemasok": { "type": "string", "description": "Nama sopir atau pemasok air tangki" },
        "catatan": { "type": "string", "description": "Keterangan tambahan" },
        "linkedExpenseId": { "type": "number", "description": "ID lokal pengeluaran terkait jika ada" },
        "pengeluaranSyncId": { "type": "string", "description": "SyncId pengeluaran operasional terkait" },
        "updatedAt": { "type": "number", "description": "Epoch millis pembaruan terakhir" },
        "isDeleted": { "type": "boolean", "description": "Penanda hapus sinkronisasi" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp pembaruan" }
      },
      "required": ["syncId", "tanggal", "volumeLiter", "totalHarga", "namaPemasok", "catatan", "updatedAt", "isDeleted", "serverUpdatedAt"]
    },
    "AiInsight": {
      "title": "AiInsight",
      "description": "Hasil analisis bisnis & saran operasional terbaru dari Gemini AI per akun Google pemilik depot",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Firebase Auth UID pemilik depot" },
        "depotId": { "type": "string", "description": "ID depot milik pemilik (depot_{uid})" },
        "periodDays": { "type": "number", "description": "Rentang hari evaluasi (7, 30, atau 90 hari)" },
        "insights": { "type": "array", "description": "Daftar 3 insight bisnis singkat dari Gemini AI" },
        "stockAdvice": { "type": "string", "description": "Rekomendasi stok air baku/toren mineral atau perawatan mesin RO" },
        "healthStatus": { "type": "string", "enum": ["SEHAT", "WASPADA", "KRITIS"], "description": "Status kesehatan bisnis depot" },
        "priorityActionTitle": { "type": "string", "description": "Judul tombol aksi prioritas paling mendesak" },
        "priorityActionTarget": { "type": "string", "enum": ["KASBON", "CRM", "STOK", "PERAWATAN", "LAPORAN"], "description": "Target layar navigasi aksi prioritas" },
        "totalOmzet": { "type": "number", "description": "Ringkasan omzet penjualan periode analisis" },
        "totalKasMasuk": { "type": "number", "description": "Total kas masuk riil (nota lunas, DP, dan pelunasan kasbon)" },
        "totalKomisiKurir": { "type": "number", "description": "Total beban komisi pengantaran kurir periode analisis" },
        "totalPengeluaran": { "type": "number", "description": "Total pengeluaran operasional periode analisis" },
        "labaBersih": { "type": "number", "description": "Laba bersih (totalKasMasuk - pengeluaran - komisiKurir)" },
        "marginLabaPersen": { "type": "number", "description": "Persentase margin laba bersih terhadap kas masuk" },
        "totalGalon": { "type": "number", "description": "Total galon terjual pada periode analisis" },
        "activeCustomers": { "type": "number", "description": "Jumlah pelanggan aktif depot" },
        "totalPiutang": { "type": "number", "description": "Total piutang/kasbon pelanggan aktif saat ini" },
        "overduePiutangOver30d": { "type": "number", "description": "Nominal piutang macet berumur lebih dari 30 hari" },
        "omzetGrowthPercent": { "type": "number", "description": "Pertumbuhan omzet dibanding periode sebelumnya (%)" },
        "galonGrowthPercent": { "type": "number", "description": "Pertumbuhan volume galon dibanding periode sebelumnya (%)" },
        "labaGrowthPercent": { "type": "number", "description": "Pertumbuhan laba bersih dibanding periode sebelumnya (%)" },
        "modelName": { "type": "string", "description": "Nama model Gemini AI Logic yang digunakan" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Server timestamp analisis dibuat/diperbarui" }
      },
      "required": ["ownerId", "depotId", "insights", "stockAdvice", "totalOmzet", "totalGalon", "activeCustomers", "modelName", "timestamp"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Dokumen datar pengguna pendaftar Google untuk pemantauan dan profil depot"
    },
    "/depots/{depotId}": {
      "schema": { "$ref": "#/entities/Depot" },
      "description": "Dokumen induk workspace depot bersama antara Pemilik dan Karyawan"
    },
    "/staff_links/{emailKey}": {
      "schema": { "$ref": "#/entities/StaffLink" },
      "description": "Pemetaan email Google karyawan terverifikasi ke depotId"
    },
    "/depots/{depotId}/produk/{docId}": {
      "schema": { "$ref": "#/entities/Produk" },
      "description": "Koleksi katalog produk galon per depot"
    },
    "/depots/{depotId}/kurir/{docId}": {
      "schema": { "$ref": "#/entities/Kurir" },
      "description": "Koleksi data karyawan & komisi per depot"
    },
    "/depots/{depotId}/pelanggan/{docId}": {
      "schema": { "$ref": "#/entities/Pelanggan" },
      "description": "Koleksi pelanggan & kasbon per depot"
    },
    "/depots/{depotId}/transaksi/{docId}": {
      "schema": { "$ref": "#/entities/Transaksi" },
      "description": "Koleksi transaksi penjualan per depot"
    },
    "/depots/{depotId}/pengeluaran/{docId}": {
      "schema": { "$ref": "#/entities/Pengeluaran" },
      "description": "Koleksi pengeluaran operasional (hanya Pemilik)"
    },
    "/depots/{depotId}/kasbon_logs/{docId}": {
      "schema": { "$ref": "#/entities/KasbonLog" },
      "description": "Koleksi riwayat pembayaran kasbon per depot"
    },
    "/depots/{depotId}/perawatan_jadwal/{docId}": {
      "schema": { "$ref": "#/entities/PerawatanJadwal" },
      "description": "Koleksi jadwal perawatan mesin RO (hanya Pemilik)"
    },
    "/depots/{depotId}/perawatan_log/{docId}": {
      "schema": { "$ref": "#/entities/PerawatanLog" },
      "description": "Koleksi riwayat perawatan mesin RO (hanya Pemilik)"
    },
    "/depots/{depotId}/tangki_refill/{docId}": {
      "schema": { "$ref": "#/entities/TangkiRefill" },
      "description": "Koleksi riwayat pasokan air tangki toren mineral (hanya Pemilik)"
    },
    "/ai_insights/{insightId}": {
      "schema": { "$ref": "#/entities/AiInsight" },
      "description": "Hasil AI Business Insights terbaru per pemilik depot (terisolasi ketat per ownerId)"
    }
  }
}
