@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun PelangganScreen(
    viewModel: PelangganViewModel,
    onBack: () -> Unit,
    modifier: Modifier = Modifier
) {
    val context = LocalContext.current
    val coroutineScope = rememberCoroutineScope()
    val snackbarHostState = remember { SnackbarHostState() }

    val currentTab by viewModel.currentTab.collectAsStateWithLifecycle()
    val thresholdHari by viewModel.thresholdHari.collectAsStateWithLifecycle()
    val allPelanggan by viewModel.allPelanggan.collectAsStateWithLifecycle()
    val pelangganKasbon by viewModel.pelangganKasbon.collectAsStateWithLifecycle()
    val kasbonSearchQuery by viewModel.kasbonSearchQuery.collectAsStateWithLifecycle()
    val kasbonSortOption by viewModel.kasbonSortOption.collectAsStateWithLifecycle()
    val transaksiKasbonMap by viewModel.transaksiKasbonMap.collectAsStateWithLifecycle()
    val topPelanggan by viewModel.topPelanggan.collectAsStateWithLifecycle()
    val pelangganPasif by viewModel.pelangganPasif.collectAsStateWithLifecycle()

    val receiptHelper = remember { SantoyaReceiptHelper(context) }
    var selesaiKasbonStruk by remember { mutableStateOf<String?>(null) }
    var selesaiKasbonPhone by remember { mutableStateOf<String?>(null) }
    var showPrinterDialog by remember { mutableStateOf(false) }
    var pairedDevices by remember { mutableStateOf<List<BluetoothDevice>>(emptyList()) }
    var pendingReceiptText by remember { mutableStateOf("") }

    fun printReceipt(receiptText: String) {
        val devices = receiptHelper.getPairedBluetoothDevices()
        if (devices.isEmpty()) {
            Toast.makeText(
                context,
                "Tidak ada printer Bluetooth yang terhubung. Pasangkan printer di pengaturan HP.",
                Toast.LENGTH_LONG
            ).show()
            return
        }
        if (devices.size == 1) {
            val device = devices.first()
            @SuppressLint("MissingPermission")
            val deviceName = device.name ?: device.address
            Toast.makeText(context, "Mencetak ke $deviceName...", Toast.LENGTH_SHORT).show()
            coroutineScope.launch {
                val result = receiptHelper.printViaBluetooth(device.address, receiptText)
                if (result.isSuccess) {
                    Toast.makeText(context, "Struk berhasil dicetak!", Toast.LENGTH_SHORT).show()
                } else {
                    Toast.makeText(
                        context,
                        "Gagal mencetak: ${result.exceptionOrNull()?.localizedMessage}",
                        Toast.LENGTH_LONG
                    ).show()
                }
            }
        } else {
            pairedDevices = devices
            pendingReceiptText = receiptText
            showPrinterDialog = true
        }
    }

    var searchQuery by remember { mutableStateOf("") }
    var showAddEditDialog by remember { mutableStateOf(false) }
    var selectedPelangganForEdit by remember { mutableStateOf<Pelanggan?>(null) }
    var selectedPelangganForKasbon by remember { mutableStateOf<Pelanggan?>(null) }
    var pelangganToDelete by remember { mutableStateOf<Pelanggan?>(null) }

    Scaffold(
        modifier = modifier.testTag("pelanggan_screen"),
        snackbarHost = { SnackbarHost(snackbarHostState) },
        topBar = {
            TopAppBar(
                title = {
                    Column {
                        Text("Data Pelanggan", fontWeight = FontWeight.Bold, maxLines = 1, overflow = TextOverflow.Ellipsis)
                        Text(
                            "Santoya Depot Air RO",
                            style = MaterialTheme.typography.bodySmall,
                            color = MaterialTheme.colorScheme.onSurfaceVariant,
                            maxLines = 1
                        )
                    }
                },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Kembali")
                    }
                },
                actions = {
                    IconButton(
                        onClick = {
                            coroutineScope.launch {
                                try {
                                    val exportData = viewModel.getExportData()
                                    val result = BackupHelper.shareBackupJson(context, exportData)
                                    if (result.isSuccess) {
                                        snackbarHostState.showSnackbar("File backup JSON berhasil disiapkan!")
                                    } else {
                                        snackbarHostState.showSnackbar(
                                            "Gagal membagikan backup: ${result.exceptionOrNull()?.localizedMessage}"
                                        )
                                    }
                                } catch (e: Exception) {
                                    snackbarHostState.showSnackbar("Terjadi kesalahan: ${e.localizedMessage}")
                                }
                            }
                        }
                    ) {
                        Icon(Icons.Default.Share, contentDescription = "Export Backup JSON")
                    }
                },
                colors = TopAppBarDefaults.topAppBarColors(containerColor = MaterialTheme.colorScheme.surface)
            )
        },
        floatingActionButton = {
            FloatingActionButton(
                onClick = {
                    selectedPelangganForEdit = null
                    showAddEditDialog = true
                },
                modifier = Modifier.testTag("tambah_pelanggan_fab"),
                containerColor = MaterialTheme.colorScheme.primary,
                contentColor = MaterialTheme.colorScheme.onPrimary
            ) {
                Icon(Icons.Default.Add, contentDescription = "Tambah Pelanggan")
            }
        }
    ) { innerPadding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
        ) {
            TabRow(selectedTabIndex = currentTab.ordinal) {
                Tab(
                    selected = currentTab == PelangganTab.SEMUA,
                    onClick = { viewModel.selectTab(PelangganTab.SEMUA) },
                    text = { Text("Semua (${allPelanggan.size})", maxLines = 1) }
                )
                Tab(
                    selected = currentTab == PelangganTab.KASBON,
                    onClick = { viewModel.selectTab(PelangganTab.KASBON) },
                    text = { Text("Kasbon (${pelangganKasbon.size})", maxLines = 1) }
                )
                Tab(
                    selected = currentTab == PelangganTab.TOP_RANKING,
                    onClick = { viewModel.selectTab(PelangganTab.TOP_RANKING) },
                    text = { Text("Top", maxLines = 1) }
                )
                Tab(
                    selected = currentTab == PelangganTab.PASIF,
                    onClick = { viewModel.selectTab(PelangganTab.PASIF) },
                    text = { Text("Pasif (${pelangganPasif.size})", maxLines = 1) }
                )
            }

            when (currentTab) {
                PelangganTab.SEMUA -> {
                    Column(modifier = Modifier.fillMaxSize()) {
                        OutlinedTextField(
                            value = searchQuery,
                            onValueChange = { searchQuery = it },
                            placeholder = { Text("Cari nama, alamat, atau HP...") },
                            leadingIcon = { Icon(Icons.Default.Search, contentDescription = null, tint = MaterialTheme.colorScheme.primary) },
                            trailingIcon = {
                                if (searchQuery.isNotEmpty()) {
                                    IconButton(onClick = { searchQuery = "" }) {
                                        Icon(Icons.Default.Clear, contentDescription = "Bersihkan", modifier = Modifier.size(18.dp))
                                    }
                                }
                            },
                            singleLine = true,
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(horizontal = 14.dp, vertical = 8.dp),
                            shape = RoundedCornerShape(10.dp)
                        )

                        val filteredList = allPelanggan.filter {
                            it.nama.contains(searchQuery, ignoreCase = true) ||
                            it.alamat.contains(searchQuery, ignoreCase = true) ||
                            it.no_hp.contains(searchQuery)
                        }

                        if (filteredList.isEmpty()) {
                            EmptyState(
                                icon = Icons.Default.People,
                                title = if (searchQuery.isBlank()) "Belum ada pelanggan" else "Pelanggan tidak ditemukan",
                                subtitle = if (searchQuery.isBlank()) "Tekan tombol + untuk menambahkan data baru." else "Coba kata kunci pencarian yang lain."
                            )
                        } else {
                            LazyColumn(
                                modifier = Modifier.fillMaxSize(),
                                contentPadding = PaddingValues(start = 14.dp, end = 14.dp, top = 6.dp, bottom = 80.dp),
                                verticalArrangement = Arrangement.spacedBy(10.dp)
                            ) {
                                items(filteredList, key = { it.id }) { pelanggan ->
                                    val rincianKasbon = transaksiKasbonMap[pelanggan.id] ?: emptyList()
                                    PelangganCard(
                                        pelanggan = pelanggan,
                                        transaksiKasbon = rincianKasbon,
                                        onEdit = {
                                            selectedPelangganForEdit = pelanggan
                                            showAddEditDialog = true
                                        },
                                        onBayarKasbon = { selectedPelangganForKasbon = pelanggan },
                                        onDelete = { pelangganToDelete = pelanggan },
                                        onCall = {
                                            if (pelanggan.no_hp.isNotBlank()) {
                                                context.startActivity(Intent(Intent.ACTION_DIAL, Uri.parse("tel:${pelanggan.no_hp}")))
                                            }
                                        },
                                        onPrintKasbon = if (pelanggan.sisa_kasbon > 0) {
                                            {
                                                val text = receiptHelper.formatNotaTagihanKasbon(
                                                    namaPelanggan = pelanggan.nama,
                                                    alamatPelanggan = pelanggan.alamat,
                                                    nomorHp = pelanggan.no_hp,
                                                    totalKasbon = pelanggan.sisa_kasbon,
                                                    daftarTransaksiKasbon = rincianKasbon
                                                )
                                                printReceipt(text)
                                            }
                                        } else null,
                                        onShareKasbon = if (pelanggan.sisa_kasbon > 0) {
                                            {
                                                val result = receiptHelper.shareTagihanKasbon(
                                                    namaPelanggan = pelanggan.nama,
                                                    alamatPelanggan = pelanggan.alamat,
                                                    nomorHp = pelanggan.no_hp,
                                                    totalKasbon = pelanggan.sisa_kasbon,
                                                    daftarTransaksiKasbon = rincianKasbon
                                                )
                                                if (result.isFailure) {
                                                    Toast.makeText(context, "Gagal membagikan tagihan", Toast.LENGTH_SHORT).show()
                                                }
                                            }
                                        } else null
                                    )
                                }
                            }
                        }
                    }
                }

                PelangganTab.KASBON -> {
                    Column(modifier = Modifier.fillMaxSize()) {
                        OutlinedTextField(
                            value = kasbonSearchQuery,
                            onValueChange = { viewModel.setKasbonSearchQuery(it) },
                            placeholder = { Text("Cari nama atau alamat kasbon...") },
                            leadingIcon = { Icon(Icons.Default.Search, contentDescription = null, tint = MaterialTheme.colorScheme.primary) },
                            trailingIcon = {
                                if (kasbonSearchQuery.isNotEmpty()) {
                                    IconButton(onClick = { viewModel.setKasbonSearchQuery("") }) {
                                        Icon(Icons.Default.Clear, contentDescription = "Hapus", modifier = Modifier.size(18.dp))
                                    }
                                }
                            },
                            singleLine = true,
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(horizontal = 14.dp, vertical = 6.dp),
                            shape = RoundedCornerShape(10.dp)
                        )

                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(horizontal = 14.dp, vertical = 2.dp),
                            verticalAlignment = Alignment.CenterVertically,
                            horizontalArrangement = Arrangement.spacedBy(6.dp)
                        ) {
                            Icon(Icons.Default.Sort, contentDescription = null, tint = MaterialTheme.colorScheme.onSurfaceVariant, modifier = Modifier.size(16.dp))
                            Text("Urutkan:", style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
                            KasbonSortOption.values().forEach { option ->
                                FilterChip(
                                    selected = kasbonSortOption == option,
                                    onClick = { viewModel.setKasbonSortOption(option) },
                                    label = { Text(option.label, maxLines = 1) },
                                    leadingIcon = if (kasbonSortOption == option) {
                                        { Icon(Icons.Default.Check, contentDescription = null, modifier = Modifier.size(14.dp)) }
                                    } else null,
                                    colors = FilterChipDefaults.filterChipColors(
                                        selectedContainerColor = MaterialTheme.colorScheme.primaryContainer,
                                        selectedLabelColor = MaterialTheme.colorScheme.onPrimaryContainer
                                    ),
                                    modifier = Modifier.height(32.dp)
                                )
                            }
                        }

                        if (pelangganKasbon.isEmpty()) {
                            EmptyState(
                                icon = Icons.Default.HourglassBottom,
                                title = if (kasbonSearchQuery.isBlank()) "Tidak ada tagihan kasbon" else "Pelanggan kasbon tidak ditemukan",
                                subtitle = if (kasbonSearchQuery.isBlank()) "Semua pelanggan telah melunasi tagihan galon." else "Coba kata kunci pencarian yang lain."
                            )
                        } else {
                            LazyColumn(
                                modifier = Modifier.fillMaxSize(),
                                contentPadding = PaddingValues(start = 14.dp, end = 14.dp, top = 8.dp, bottom = 80.dp),
                                verticalArrangement = Arrangement.spacedBy(10.dp)
                            ) {
                                item {
                                    Surface(
                                        color = MaterialTheme.colorScheme.errorContainer.copy(alpha = 0.45f),
                                        shape = RoundedCornerShape(10.dp),
                                        modifier = Modifier.fillMaxWidth()
                                    ) {
                                        Row(
                                            modifier = Modifier.padding(horizontal = 14.dp, vertical = 10.dp),
                                            verticalAlignment = Alignment.CenterVertically,
                                            horizontalArrangement = Arrangement.SpaceBetween
                                        ) {
                                            Row(verticalAlignment = Alignment.CenterVertically) {
                                                Icon(Icons.Default.HourglassBottom, contentDescription = null, tint = MaterialTheme.colorScheme.error, modifier = Modifier.size(22.dp))
                                                Spacer(modifier = Modifier.width(8.dp))
                                                Column {
                                                    Text("Total Piutang Kasbon", style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onErrorContainer)
                                                    Text(
                                                        Formatters.formatRupiah(pelangganKasbon.sumOf { it.sisa_kasbon }),
                                                        style = MaterialTheme.typography.titleMedium,
                                                        fontWeight = FontWeight.Bold,
                                                        color = MaterialTheme.colorScheme.error
                                                    )
                                                }
                                            }
                                            Text(
                                                "${pelangganKasbon.size} Pelanggan",
                                                style = MaterialTheme.typography.labelMedium,
                                                fontWeight = FontWeight.SemiBold,
                                                color = MaterialTheme.colorScheme.onErrorContainer
                                            )
                                        }
                                    }
                                }

                                items(pelangganKasbon, key = { it.id }) { pelanggan ->
                                    val rincianKasbon = transaksiKasbonMap[pelanggan.id] ?: emptyList()
                                    PelangganCard(
                                        pelanggan = pelanggan,
                                        transaksiKasbon = rincianKasbon,
                                        onEdit = {
                                            selectedPelangganForEdit = pelanggan
                                            showAddEditDialog = true
                                        },
                                        onBayarKasbon = { selectedPelangganForKasbon = pelanggan },
                                        onDelete = { pelangganToDelete = pelanggan },
                                        onCall = {
                                            if (pelanggan.no_hp.isNotBlank()) {
                                                context.startActivity(Intent(Intent.ACTION_DIAL, Uri.parse("tel:${pelanggan.no_hp}")))
                                            }
                                        },
                                        onPrintKasbon = {
                                            val text = receiptHelper.formatNotaTagihanKasbon(
                                                namaPelanggan = pelanggan.nama,
                                                alamatPelanggan = pelanggan.alamat,
                                                nomorHp = pelanggan.no_hp,
                                                totalKasbon = pelanggan.sisa_kasbon,
                                                daftarTransaksiKasbon = rincianKasbon
                                            )
                                            printReceipt(text)
                                        },
                                        onShareKasbon = {
                                            val result = receiptHelper.shareTagihanKasbon(
                                                namaPelanggan = pelanggan.nama,
                                                alamatPelanggan = pelanggan.alamat,
                                                nomorHp = pelanggan.no_hp,
                                                totalKasbon = pelanggan.sisa_kasbon,
                                                daftarTransaksiKasbon = rincianKasbon
                                            )
                                            if (result.isFailure) {
                                                Toast.makeText(context, "Gagal membagikan tagihan", Toast.LENGTH_SHORT).show()
                                            }
                                        }
                                    )
                                }
                            }
                        }
                    }
                }

                PelangganTab.TOP_RANKING -> {
                    if (topPelanggan.isEmpty()) {
                        EmptyState(
                            icon = Icons.Default.EmojiEvents,
                            title = "Belum Ada Ranking Penjualan",
                            subtitle = "Ranking akan terisi otomatis saat transaksi penjualan disimpan."
                        )
                    } else {
                        LazyColumn(
                            modifier = Modifier.fillMaxSize(),
                            contentPadding = PaddingValues(start = 14.dp, end = 14.dp, top = 10.dp, bottom = 80.dp),
                            verticalArrangement = Arrangement.spacedBy(10.dp)
                        ) {
                            itemsIndexed(topPelanggan, key = { _, item -> item.id }) { index, topItem ->
                                TopPelangganCard(rank = index + 1, item = topItem)
                            }
                        }
                    }
                }

                PelangganTab.PASIF -> {
                    Column(modifier = Modifier.fillMaxSize()) {
                        Surface(
                            color = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.35f),
                            modifier = Modifier.fillMaxWidth()
                        ) {
                            Row(
                                modifier = Modifier.padding(horizontal = 14.dp, vertical = 6.dp),
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(6.dp)
                            ) {
                                Text("Rentang:", style = MaterialTheme.typography.labelSmall, fontWeight = FontWeight.SemiBold)
                                listOf(7, 14, 30, 60).forEach { days ->
                                    FilterChip(
                                        selected = thresholdHari == days,
                                        onClick = { viewModel.setThresholdHari(days) },
                                        label = { Text("> $days Hari", maxLines = 1) },
                                        modifier = Modifier.height(32.dp),
                                        colors = FilterChipDefaults.filterChipColors(
                                            selectedContainerColor = MaterialTheme.colorScheme.errorContainer,
                                            selectedLabelColor = MaterialTheme.colorScheme.onErrorContainer
                                        )
                                    )
                                }
                            }
                        }

                        if (pelangganPasif.isEmpty()) {
                            EmptyState(
                                icon = Icons.Default.PersonOff,
                                title = "Semua Pelanggan Aktif",
                                subtitle = "Tidak ada pelanggan pasif dalam rentang waktu $thresholdHari hari terakhir."
                            )
                        } else {
                            LazyColumn(
                                modifier = Modifier.fillMaxSize(),
                                contentPadding = PaddingValues(start = 14.dp, end = 14.dp, top = 8.dp, bottom = 80.dp),
                                verticalArrangement = Arrangement.spacedBy(10.dp)
                            ) {
                                items(pelangganPasif, key = { it.id }) { pelanggan ->
                                    PelangganPasifCard(
                                        pelanggan = pelanggan,
                                        onCall = {
                                            if (pelanggan.no_hp.isNotBlank()) {
                                                context.startActivity(Intent(Intent.ACTION_DIAL, Uri.parse("tel:${pelanggan.no_hp}")))
                                            }
                                        }
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (showAddEditDialog) {
        PelangganAddEditDialog(
            pelanggan = selectedPelangganForEdit,
            onDismiss = { showAddEditDialog = false },
            onSave = { nama, alamat, noHp ->
                if (selectedPelangganForEdit == null) {
                    viewModel.tambahPelanggan(nama, alamat, noHp) {
                        coroutineScope.launch { snackbarHostState.showSnackbar("Pelanggan $nama ditambahkan") }
                    }
                } else {
                    viewModel.updatePelanggan(
                        selectedPelangganForEdit!!.copy(nama = nama, alamat = alamat, no_hp = noHp)
                    )
                    coroutineScope.launch { snackbarHostState.showSnackbar("Data pelanggan diperbarui") }
                }
                showAddEditDialog = false
            }
        )
    }

    selectedPelangganForKasbon?.let { pelanggan ->
        PelunasanKasbonDialog(
            pelanggan = pelanggan,
            onDismiss = { selectedPelangganForKasbon = null },
            onBayar = { nominal ->
                viewModel.lunasiKasbon(pelanggan.id, nominal) {
                    val sisaBaru = (pelanggan.sisa_kasbon - nominal).coerceAtLeast(0.0)
                    val receiptText = receiptHelper.formatNotaPelunasanKasbon(
                        namaPelanggan = pelanggan.nama,
                        alamatPelanggan = pelanggan.alamat,
                        tanggal = Formatters.formatDateTime(System.currentTimeMillis()),
                        kasbonSebelumnya = pelanggan.sisa_kasbon,
                        nominalBayar = nominal,
                        sisaKasbonSetelah = sisaBaru
                    )
                    selesaiKasbonStruk = receiptText
                    selesaiKasbonPhone = pelanggan.no_hp
                    coroutineScope.launch { snackbarHostState.showSnackbar("Pembayaran kasbon berhasil!") }
                }
                selectedPelangganForKasbon = null
            }
        )
    }

    selesaiKasbonStruk?.let { strukText ->
        AlertDialog(
            onDismissRequest = { selesaiKasbonStruk = null },
            title = {
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Icon(imageVector = Icons.Default.CheckCircle, contentDescription = null, tint = Color(0xFF2E7D32))
                    Spacer(modifier = Modifier.width(8.dp))
                    Text("Pelunasan Berhasil", fontWeight = FontWeight.Bold, maxLines = 1, overflow = TextOverflow.Ellipsis)
                }
            },
            text = {
                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                    Text("Bukti pelunasan siap dicetak ke printer Bluetooth atau dibagikan ke WhatsApp pelanggan.", style = MaterialTheme.typography.bodySmall)
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        Button(
                            onClick = { printReceipt(strukText) },
                            modifier = Modifier.weight(1f),
                            shape = RoundedCornerShape(8.dp)
                        ) {
                            Icon(Icons.Default.Print, contentDescription = null, modifier = Modifier.size(16.dp))
                            Spacer(modifier = Modifier.width(6.dp))
                            Text("Cetak")
                        }
                        OutlinedButton(
                            onClick = {
                                receiptHelper.shareImageToWhatsApp(
                                    receiptText = strukText,
                                    phoneNumber = selesaiKasbonPhone,
                                    title = "Bukti Pelunasan Kasbon"
                                )
                            },
                            modifier = Modifier.weight(1f),
                            shape = RoundedCornerShape(8.dp)
                        ) {
                            Icon(Icons.Default.Share, contentDescription = null, modifier = Modifier.size(16.dp))
                            Spacer(modifier = Modifier.width(6.dp))
                            Text("WA")
                        }
                    }
                }
            },
            confirmButton = {},
            dismissButton = {
                TextButton(onClick = { selesaiKasbonStruk = null }) { Text("Tutup") }
            }
        )
    }

    if (showPrinterDialog) {
        AlertDialog(
            onDismissRequest = { showPrinterDialog = false },
            title = { Text("Pilih Printer Bluetooth") },
            text = {
                Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
                    pairedDevices.forEach { device ->
                        @SuppressLint("MissingPermission")
                        val devName = device.name ?: device.address
                        Surface(
                            modifier = Modifier
                                .fillMaxWidth()
                                .clickable {
                                    showPrinterDialog = false
                                    coroutineScope.launch {
                                        receiptHelper.printViaBluetooth(device.address, pendingReceiptText)
                                    }
                                },
                            shape = RoundedCornerShape(8.dp),
                            color = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f)
                        ) {
                            Row(modifier = Modifier.padding(10.dp), verticalAlignment = Alignment.CenterVertically) {
                                Icon(Icons.Default.Print, contentDescription = null, tint = MaterialTheme.colorScheme.primary)
                                Spacer(modifier = Modifier.width(10.dp))
                                Column {
