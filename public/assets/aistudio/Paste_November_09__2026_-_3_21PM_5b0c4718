@Composable
private fun PelangganAddEditDialog(
    pelanggan: Pelanggan?,
    onDismiss: () -> Unit,
    onSave: (nama: String, alamat: String, noHp: String) -> Unit
) {
    var nama by remember { mutableStateOf(pelanggan?.nama ?: "") }
    var alamat by remember { mutableStateOf(pelanggan?.alamat ?: "") }
    var noHp by remember { mutableStateOf(pelanggan?.no_hp ?: "") }
    var errorMessage by remember { mutableStateOf<String?>(null) }

    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text(if (pelanggan == null) "Tambah Pelanggan Baru" else "Edit Pelanggan", fontWeight = FontWeight.Bold) },
        text = {
            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                OutlinedTextField(
                    value = nama,
                    onValueChange = { nama = it; errorMessage = null },
                    label = { Text("Nama Pelanggan *") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(10.dp)
                )
                OutlinedTextField(
                    value = alamat,
                    onValueChange = { alamat = it },
                    label = { Text("Alamat / Desa") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(10.dp)
                )
                OutlinedTextField(
                    value = noHp,
                    onValueChange = { noHp = it.filter { c -> c.isDigit() || c == '+' } },
                    label = { Text("Nomor HP / WA") },
                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Phone),
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(10.dp)
                )
                if (errorMessage != null) {
                    Text(errorMessage ?: "", color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall)
                }
            }
        },
        confirmButton = {
            Button(
                onClick = {
                    if (nama.isBlank()) {
                        errorMessage = "Nama wajib diisi!"
                        return@Button
                    }
                    onSave(nama.trim(), alamat.trim(), noHp.trim())
                }
            ) { Text("Simpan") }
        },
        dismissButton = { TextButton(onClick = onDismiss) { Text("Batal") } }
    )
}

@Composable
private fun PelunasanKasbonDialog(
    pelanggan: Pelanggan,
    onDismiss: () -> Unit,
    onBayar: (nominal: Double) -> Unit
) {
    var nominalStr by remember { mutableStateOf(pelanggan.sisa_kasbon.toLong().toString()) }
    var errorMessage by remember { mutableStateOf<String?>(null) }

    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text("Pelunasan Kasbon", fontWeight = FontWeight.Bold) },
        text = {
            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                Text("Pelanggan: ${pelanggan.nama}", style = MaterialTheme.typography.bodyMedium, fontWeight = FontWeight.Bold, maxLines = 1, overflow = TextOverflow.Ellipsis)
                Text("Total Kasbon: ${Formatters.formatRupiah(pelanggan.sisa_kasbon)}", color = MaterialTheme.colorScheme.error, fontWeight = FontWeight.SemiBold)
                OutlinedTextField(
                    value = nominalStr,
                    onValueChange = { nominalStr = it.filter { c -> c.isDigit() }; errorMessage = null },
                    label = { Text("Nominal Bayar (Rp) *") },
                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(10.dp)
                )
                Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
                    OutlinedButton(
                        onClick = { nominalStr = pelanggan.sisa_kasbon.toLong().toString() },
                        modifier = Modifier.weight(1f)
                    ) { Text("Lunas Penuh") }
                    if (pelanggan.sisa_kasbon > 10000) {
                        OutlinedButton(
                            onClick = { nominalStr = (pelanggan.sisa_kasbon / 2).toLong().toString() },
                            modifier = Modifier.weight(1f)
                        ) { Text("Bayar 50%") }
                    }
                }
                if (errorMessage != null) {
                    Text(errorMessage ?: "", color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall)
                }
            }
        },
        confirmButton = {
            Button(
                onClick = {
                    val nominal = nominalStr.toDoubleOrNull()
                    if (nominal == null || nominal <= 0) {
                        errorMessage = "Nominal pembayaran tidak valid!"
                        return@Button
                    }
                    if (nominal > pelanggan.sisa_kasbon) {
                        errorMessage = "Nominal melebihi sisa kasbon!"
                        return@Button
                    }
                    onBayar(nominal)
                }
            ) { Text("Konfirmasi") }
        },
        dismissButton = { TextButton(onClick = onDismiss) { Text("Batal") } }
    )
}

